{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|Read",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PROJECT_DIR}/.harness/scripts/guard.sh\"", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PROJECT_DIR}/.harness/scripts/quick-check.sh\"", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PROJECT_DIR}/.harness/scripts/run-related-tests.sh\"", "timeout": 300 }
        ]
      }
    ]
  }
}
