{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c203.local/schemas/worklog.schema.json",
  "title": "C203 Work Log Event",
  "type": "object",
  "required": ["time", "type", "summary"],
  "properties": {
    "time": { "type": "string", "format": "date-time" },
    "type": {
      "type": "string",
      "enum": ["START", "ERROR", "ATTEMPT", "DECISION", "ROOT_CAUSE", "SOLUTION", "VERIFICATION", "BLOCKED", "FINISH"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "evidence": { "type": "string" },
    "result": { "type": "string" },
    "reason": { "type": "string" },
    "verification": { "type": "string" },
    "branch": { "type": "string" },
    "domain": { "type": "string" },
    "workType": { "type": "string" },
    "owner": { "type": "string" },
    "notionUrl": { "type": "string" },
    "mrUrl": { "type": "string" }
  },
  "additionalProperties": false
}
